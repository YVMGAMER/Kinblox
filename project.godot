; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="kinblox/"
config/description="Kinblox: a falling-block puzzle game with Color Chains."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.054902, 0.058824, 0.07451, 1)
boot_splash/show_image=false

[autoload]

SaveData="*res://autoload/save_data.gd"
Settings="*res://autoload/settings.gd"
ThemeManager="*res://autoload/theme_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
Haptics="*res://autoload/haptics.gd"
GameState="*res://autoload/game_state.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_call_argument=0

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[gui]

common/snap_controls_to_pixels=true

