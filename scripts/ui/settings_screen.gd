extends MenuScreen
## Every player preference, grouped into cards. Changes apply immediately
## and are saved by the Settings autoload.

var _confirm: ConfirmOverlay
var _intensity: HSlider
var _sensitivity_row: Control


func _title() -> String:
	return "Settings"


func _build() -> void:
	_section("Audio")
	_card([
		UiFactory.row("Music", _slider(&"music_volume", 0.0, 1.0)),
		UiFactory.row("Sound effects", _slider(&"sfx_volume", 0.0, 1.0)),
	])

	_section("Haptics")
	_intensity = _slider(&"haptics_intensity", 0.1, 1.0)
	_intensity.editable = Settings.haptics_enabled()
	_card([
		UiFactory.row("Vibration", _switch(&"haptics", func(on: bool) -> void:
			_intensity.editable = on
			if on:
				Haptics.pulse(Haptics.Kind.LINE_CLEAR))),
		UiFactory.row("Intensity", _intensity),
	])

	_section("Controls")
	var scheme := _segmented(&"control_scheme", ["Gestures", "Buttons"])
	_sensitivity_row = UiFactory.row("Drag sensitivity", _slider(&"sensitivity", 0.5, 2.0), "Columns moved per finger travel")
	_card([
		UiFactory.row("Control scheme", scheme),
		UiFactory.label("Gestures: drag to move, tap to rotate, two-finger tap to rotate back, drag down to soft drop, flick down to drop. Buttons: an on-screen pad.", &"MutedLabel", HORIZONTAL_ALIGNMENT_LEFT, true),
		_sensitivity_row,
		UiFactory.row("Ghost piece", _switch(&"ghost")),
	])
	_sensitivity_row.visible = Settings.control_scheme() == Settings.ControlScheme.GESTURES

	_section("Gameplay")
	_card([
		UiFactory.row("Color Chain", _switch(&"chains"), "Off plays Pure, the classic variant with its own high score. Daily always uses chains."),
	])

	_section("Display")
	var grid := GridContainer.new()
	grid.columns = 2
	grid.add_theme_constant_override(&"h_separation", UiTokens.S3)
	grid.add_theme_constant_override(&"v_separation", UiTokens.S3)
	var group := ButtonGroup.new()
	for id in ThemeManager.ORDER:
		var swatch := ThemeSwatch.new(ThemeManager.theme_for(id))
		swatch.button_group = group
		swatch.button_pressed = id == Settings.theme_id()
		swatch.pressed.connect(func() -> void:
			AudioManager.play(AudioManager.Sfx.UI_TAP)
			Settings.set_value(&"theme", id))
		grid.add_child(swatch)
	_card([
		UiFactory.label("Theme", &"HeadingLabel"),
		grid,
		UiFactory.row("Reduce motion", _switch(&"reduce_motion"), "No shake, slides or drifting backgrounds"),
		UiFactory.row("Colorblind patterns", _switch(&"patterns"), "A distinct mark on every color"),
	])

	_section("Data")
	_confirm = ConfirmOverlay.new()
	_confirm.confirmed.connect(_reset_data)
	_card([
		UiFactory.label("Erase high scores, stats, Daily history and settings on this device.", &"MutedLabel", HORIZONTAL_ALIGNMENT_LEFT, true),
		UiFactory.button("Reset all data", &"DangerButton", "", func() -> void:
			_confirm.ask("Reset all data?", "This erases every score, stat, Daily result and setting. It cannot be undone.", "Reset everything")),
	])

	_section("About")
	_card([
		UiFactory.label("Kinblox %s" % ProjectSettings.get_setting("application/config/version", "1.0.0"), &"HeadingLabel"),
		UiFactory.label("Made by Yash", &"AccentLabel"),
		UiFactory.label("Font: Manrope (SIL Open Font License). All sounds and music are generated by the game itself.", &"MutedLabel", HORIZONTAL_ALIGNMENT_LEFT, true),
	])
	column.add_child(UiFactory.spacer(UiTokens.S5))
	add_child(_confirm)


func handle_back() -> bool:
	if _confirm.visible:
		_confirm.close()
		return true
	return super.handle_back()


func _section(title: String) -> void:
	var l := UiFactory.label(title.to_upper(), &"CaptionLabel")
	column.add_child(l)


func _card(children: Array) -> void:
	var parts := UiFactory.card()
	var box: VBoxContainer = parts[1]
	for c: Control in children:
		box.add_child(c)
	column.add_child(parts[0])


func _slider(key: StringName, lo: float, hi: float) -> HSlider:
	var s := HSlider.new()
	s.min_value = lo
	s.max_value = hi
	s.step = 0.01
	s.value = float(Settings.get_value(key))
	s.custom_minimum_size = Vector2(400, 64)
	s.focus_mode = Control.FOCUS_NONE
	s.value_changed.connect(func(v: float) -> void: Settings.set_value(key, v))
	if key == &"sfx_volume":
		s.drag_ended.connect(func(_changed: bool) -> void: AudioManager.play(AudioManager.Sfx.CLEAR))
	return s


func _switch(key: StringName, extra: Callable = Callable()) -> ToggleSwitch:
	var sw := ToggleSwitch.new()
	sw.set_on_silently(bool(Settings.get_value(key)))
	sw.toggled.connect(func(on: bool) -> void:
		Settings.set_value(key, on)
		if extra.is_valid():
			extra.call(on))
	return sw


func _segmented(key: StringName, labels: Array) -> HBoxContainer:
	var box := HBoxContainer.new()
	box.add_theme_constant_override(&"separation", UiTokens.S2)
	var group := ButtonGroup.new()
	var current := int(Settings.get_value(key))
	for i in labels.size():
		var b := Button.new()
		b.text = labels[i]
		b.theme_type_variation = &"ChipButton"
		b.toggle_mode = true
		b.button_group = group
		b.button_pressed = i == current
		b.focus_mode = Control.FOCUS_NONE
		b.custom_minimum_size = Vector2(0, 80)
		b.pressed.connect(func() -> void:
			AudioManager.play(AudioManager.Sfx.UI_TAP)
			Settings.set_value(key, i)
			if key == &"control_scheme":
				_sensitivity_row.visible = i == Settings.ControlScheme.GESTURES)
		box.add_child(b)
	return box


func _reset_data() -> void:
	SaveData.reset_all()
	GameState.goto(GameState.SETTINGS)
