extends Node
## Plays sound effects and music on dedicated buses. Every sound is keyed by
## an enum and mapped to a file here, so assets can be swapped without
## touching gameplay code. The shipped files are generated by
## tools/generate_audio.gd (see docs/CREDITS.md).

enum Sfx { MOVE, ROTATE, SOFT_DROP, HARD_DROP, LOCK, HOLD, CLEAR, CLEAR_QUAD, CHAIN, LEVEL_UP, GAME_OVER, ZEN_SWEEP, UI_TAP, UI_BACK, COUNTDOWN }
enum Music { NONE, AMBIENT, ZEN }

const SFX_FILES := {
	Sfx.MOVE: "sfx_move",
	Sfx.ROTATE: "sfx_rotate",
	Sfx.SOFT_DROP: "sfx_soft_drop",
	Sfx.HARD_DROP: "sfx_hard_drop",
	Sfx.LOCK: "sfx_lock",
	Sfx.HOLD: "sfx_hold",
	Sfx.CLEAR: "sfx_clear",
	Sfx.CLEAR_QUAD: "sfx_clear_quad",
	Sfx.CHAIN: "sfx_chain",
	Sfx.LEVEL_UP: "sfx_level_up",
	Sfx.GAME_OVER: "sfx_game_over",
	Sfx.ZEN_SWEEP: "sfx_zen_sweep",
	Sfx.UI_TAP: "sfx_ui_tap",
	Sfx.UI_BACK: "sfx_ui_back",
	Sfx.COUNTDOWN: "sfx_countdown",
}
const MUSIC_FILES := {
	Music.AMBIENT: "music_ambient",
	Music.ZEN: "music_zen",
}
## Per-sound trim so the generated set sits at a consistent loudness.
const SFX_GAIN_DB := {
	Sfx.MOVE: -10.0,
	Sfx.SOFT_DROP: -14.0,
	Sfx.UI_TAP: -6.0,
	Sfx.UI_BACK: -6.0,
}
const AUDIO_DIR := "res://assets/audio/"
const SFX_BUS := &"SFX"
const MUSIC_BUS := &"Music"
const POOL_SIZE := 12
const MUSIC_FADE := 1.2

var _streams: Dictionary = {}  # Sfx -> AudioStream
var _pool: Array[AudioStreamPlayer] = []
var _next_player := 0
var _music_a: AudioStreamPlayer
var _music_b: AudioStreamPlayer
var _music_track: Music = Music.NONE


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_ensure_bus(SFX_BUS)
	_ensure_bus(MUSIC_BUS)
	for sfx: Sfx in SFX_FILES:
		var stream := _load_stream(SFX_FILES[sfx])
		if stream != null:
			_streams[sfx] = stream
	for i in POOL_SIZE:
		var p := AudioStreamPlayer.new()
		p.bus = SFX_BUS
		add_child(p)
		_pool.append(p)
	_music_a = _make_music_player()
	_music_b = _make_music_player()
	_apply_volumes()
	Settings.changed.connect(_on_setting_changed)


## Release streams before shutdown so nothing is left playing at exit.
func _exit_tree() -> void:
	for p: AudioStreamPlayer in [_music_a, _music_b] + _pool:
		p.stop()
		p.stream = null
	_streams.clear()
	CellPainter.clear_cache()


func play(sfx: Sfx, pitch: float = 1.0, volume_db: float = 0.0) -> void:
	var stream: AudioStream = _streams.get(sfx)
	if stream == null:
		return
	var p := _pool[_next_player]
	_next_player = (_next_player + 1) % POOL_SIZE
	p.stream = stream
	p.pitch_scale = pitch
	p.volume_db = volume_db + float(SFX_GAIN_DB.get(sfx, 0.0))
	p.play()


## Pitch `semitones` above the base sound (chains climb a scale).
func play_semitones(sfx: Sfx, semitones: float, volume_db: float = 0.0) -> void:
	play(sfx, pow(2.0, semitones / 12.0), volume_db)


func play_music(track: Music) -> void:
	if track == _music_track:
		return
	_music_track = track
	var outgoing := _music_a if _music_a.playing else _music_b
	var incoming := _music_b if outgoing == _music_a else _music_a
	_fade(outgoing, -60.0, true)
	if track == Music.NONE:
		return
	var stream := _load_stream(MUSIC_FILES[track])
	if stream == null:
		return
	incoming.stream = stream
	incoming.volume_db = -40.0
	incoming.play()
	_fade(incoming, 0.0, false)


func _fade(player: AudioStreamPlayer, target_db: float, stop_after: bool) -> void:
	if not player.playing:
		return
	var tw := create_tween()
	tw.tween_property(player, "volume_db", target_db, MUSIC_FADE)
	if stop_after:
		tw.tween_callback(player.stop)


func _make_music_player() -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.bus = MUSIC_BUS
	add_child(p)
	# Fallback loop in case a swapped-in asset was imported without loop points.
	p.finished.connect(func() -> void:
		if _music_track != Music.NONE and p.volume_db > -30.0:
			p.play()
	)
	return p


func _load_stream(file_base: String) -> AudioStream:
	var path := AUDIO_DIR + file_base + ".wav"
	if not ResourceLoader.exists(path):
		return null
	return load(path) as AudioStream


func _ensure_bus(bus: StringName) -> void:
	if AudioServer.get_bus_index(bus) >= 0:
		return
	AudioServer.add_bus()
	var idx := AudioServer.bus_count - 1
	AudioServer.set_bus_name(idx, bus)
	AudioServer.set_bus_send(idx, &"Master")


func _apply_volumes() -> void:
	_set_bus_volume(SFX_BUS, Settings.sfx_volume())
	_set_bus_volume(MUSIC_BUS, Settings.music_volume())


func _set_bus_volume(bus: StringName, linear: float) -> void:
	var idx := AudioServer.get_bus_index(bus)
	AudioServer.set_bus_mute(idx, linear <= 0.001)
	AudioServer.set_bus_volume_db(idx, linear_to_db(maxf(linear, 0.001)))


func _on_setting_changed(key: StringName) -> void:
	if key == &"sfx_volume" or key == &"music_volume":
		_apply_volumes()
